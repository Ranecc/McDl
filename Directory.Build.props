<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <NoWarn>CS1591</NoWarn>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Source files carry Chinese UI strings as UTF-8 without BOM. -->
    <CodePage>65001</CodePage>
  </PropertyGroup>

  <!--
    可复现构建（reproducible build）。
    同一提交 + 同一 SDK + 同一依赖锁文件，在不同目录、不同机器上应产出逐字节相同的程序集。
    相关属性的含义与实测结果见 docs/reproducible-builds.md。
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <!-- 默认打开，命令行传 -p:ContinuousIntegrationBuild=false 可覆盖（全局属性优先级更高）。 -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">true</ContinuousIntegrationBuild>

    <!--
      把仓库根目录映射成 /_/，让 PDB 里的文档路径不随检出目录变化。
      $(MSBuildThisFileDirectory) 自带结尾反斜杠，正好是 PathMap 需要的 "目录=值" 形式。
      命令行传 -p:PathMap=... 是全局属性，会覆盖这里。

      NuGet 全局缓存目录（%USERPROFILE%\.nuget\packages）同样要映射：引用程序集的绝对路径
      会进编译器输入，不同用户名（本机 Admin、runner 上的 runneradmin）会得到不同的模块版本号
      （MVID），进而让整个程序集字节不同。实测见 docs/reproducible-builds.md。
    -->
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <PathMap Condition="'$(NuGetPackageRoot)' != ''">$(PathMap),$(NuGetPackageRoot)=/_/nuget/</PathMap>

    <!-- SourceLink 在 net48 上要求 portable PDB。 -->
    <DebugType>portable</DebugType>

    <!-- 把提交信息写进程序集，右键属性可见，也方便和 BUILD-INFO.txt 对上。 -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/Ranecc/McDl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <EmbedAllSources>false</EmbedAllSources>

    <!-- 依赖版本锁定：每个项目旁边生成 packages.lock.json，CI 用 locked mode 还原。 -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
